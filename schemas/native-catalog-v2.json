{
  "$defs": {
    "AdapterId": {
      "enum": [
        "rust-native",
        "apple-native",
        "cargo-cyclonedx",
        "github-sigstore",
        "codeql",
        "cargo-vet",
        "cargo-auditable",
        "syft",
        "harden-runner",
        "independent-rebuild",
        "scorecard",
        "dist-build-only",
        "crates-io"
      ],
      "type": "string"
    },
    "ByteIdentity": {
      "additionalProperties": false,
      "description": "An exact byte identity, independent of a filename or producer claim.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "maximum": 1073741824,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size"
      ],
      "type": "object"
    },
    "CapabilityId": {
      "enum": [
        "platform-attestations",
        "immutable-releases",
        "protected-tags",
        "protected-publish-environment",
        "protected-signing-environment",
        "apple-signing",
        "cargo-sbom",
        "dependency-policy",
        "codeql",
        "cargo-vet",
        "embedded-metadata",
        "native-sbom",
        "linux-egress",
        "independent-rebuild",
        "scorecard",
        "dist-build",
        "registry-publish"
      ],
      "type": "string"
    },
    "DistributionFormat": {
      "description": "Reviewed container formats do not imply that the consumer may extract a tool or release artifact.",
      "enum": [
        "raw",
        "tar-gz",
        "tar-xz"
      ],
      "type": "string"
    },
    "InputKind": {
      "enum": [
        "tool",
        "action",
        "helper",
        "database",
        "query-pack",
        "schema",
        "policy",
        "native-input"
      ],
      "type": "string"
    },
    "NativeAdapter": {
      "additionalProperties": false,
      "description": "An adapter uses explicit v2 pins while preserving the reviewed compatibility and workflow contract.",
      "properties": {
        "capability": {
          "$ref": "#/$defs/CapabilityId"
        },
        "config_versions": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/AdapterId"
        },
        "pins": {
          "items": {
            "$ref": "#/$defs/NativePin"
          },
          "type": "array"
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "runtime_versions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workflow": {
          "$ref": "#/$defs/WorkflowIdentity"
        }
      },
      "required": [
        "id",
        "capability",
        "config_versions",
        "runtime_versions",
        "workflow",
        "pins",
        "review"
      ],
      "type": "object"
    },
    "NativePin": {
      "additionalProperties": false,
      "description": "Lock digests always retain the distribution identity, including compressed tool archives.",
      "properties": {
        "authentication_record": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "distribution": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "format": {
          "$ref": "#/$defs/DistributionFormat"
        },
        "kind": {
          "$ref": "#/$defs/InputKind"
        },
        "material": {
          "$ref": "#/$defs/PinMaterial"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "kind",
        "format",
        "distribution",
        "authentication_record",
        "material"
      ],
      "type": "object"
    },
    "NativeTarget": {
      "description": "Only the three qualified native v0.1 hosts are representable.",
      "enum": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin"
      ],
      "type": "string"
    },
    "PinMaterial": {
      "description": "An exact input uses distribution bytes; a native member separately binds executed bytes and target.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "material": {
              "const": "exact",
              "type": "string"
            }
          },
          "required": [
            "material"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "$ref": "#/$defs/ByteIdentity"
            },
            "material": {
              "const": "native-member",
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "target": {
              "$ref": "#/$defs/NativeTarget"
            }
          },
          "required": [
            "material",
            "target",
            "name",
            "bytes"
          ],
          "type": "object"
        }
      ]
    },
    "Review": {
      "additionalProperties": false,
      "description": "Review records bind a policy decision; their contents do not prove review occurred.",
      "properties": {
        "expires_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "owner": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "record": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "reviewed_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "owner",
        "rationale",
        "reviewed_at",
        "expires_at",
        "record"
      ],
      "type": "object"
    },
    "RuntimeDistributionV1": {
      "additionalProperties": false,
      "description": "Canonical USTAR bytes are common to every release selection; members remain target-specific.",
      "properties": {
        "authentication_record": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "build_workflow": {
          "$ref": "#/$defs/WorkflowIdentity"
        },
        "cargo_lock": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "compiler": {
          "type": "string"
        },
        "distribution": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "members": {
          "additionalProperties": false,
          "properties": {
            "aarch64-apple-darwin": {
              "$ref": "#/$defs/RuntimeMember"
            },
            "aarch64-unknown-linux-gnu": {
              "$ref": "#/$defs/RuntimeMember"
            },
            "x86_64-unknown-linux-gnu": {
              "$ref": "#/$defs/RuntimeMember"
            }
          },
          "type": "object"
        },
        "schema_version": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "version",
        "source",
        "compiler",
        "cargo_lock",
        "build_workflow",
        "authentication_record",
        "distribution",
        "members"
      ],
      "type": "object"
    },
    "RuntimeMember": {
      "additionalProperties": false,
      "description": "A runtime archive has exactly one bounded executable member per qualified host.",
      "properties": {
        "bytes": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "bytes"
      ],
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "git_ref": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "git_ref"
      ],
      "type": "object"
    },
    "WorkflowIdentity": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "path",
        "commit"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicitly selected v2 authority; never a fallback interpretation of catalog v1.",
  "properties": {
    "adapters": {
      "items": {
        "$ref": "#/$defs/NativeAdapter"
      },
      "type": "array"
    },
    "previous_catalog": {
      "anyOf": [
        {
          "$ref": "#/$defs/ByteIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeDistributionV1"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 2,
      "minimum": 2,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "runtime",
    "adapters"
  ],
  "title": "NativeCatalogV2",
  "type": "object"
}
