{
  "$defs": {
    "Attestations": {
      "enum": [
        "required"
      ],
      "type": "string"
    },
    "Change": {
      "additionalProperties": false,
      "properties": {
        "after_sha256": {
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
          "type": "string"
        },
        "before_sha256": {
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
          "type": [
            "string",
            "null"
          ]
        },
        "disposition": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "proposed_content": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "disposition",
        "after_sha256",
        "proposed_content"
      ],
      "type": "object"
    },
    "Config": {
      "additionalProperties": false,
      "properties": {
        "deliverables": {
          "items": {
            "$ref": "#/$defs/Deliverable"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "feature_sets": {
          "additionalProperties": {
            "$ref": "#/$defs/FeatureSet"
          },
          "maxProperties": 128,
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])"
          },
          "type": "object"
        },
        "manifest": {
          "default": "Cargo.toml",
          "pattern": "^Cargo\\.toml$(?![\\s\\S])",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$(?![\\s\\S])",
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "toolchain": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "repository",
        "toolchain",
        "deliverables",
        "feature_sets",
        "policy"
      ],
      "type": "object"
    },
    "Deliverable": {
      "additionalProperties": false,
      "properties": {
        "binary": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])",
          "type": [
            "string",
            "null"
          ]
        },
        "feature_set": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])",
          "type": "string"
        },
        "package": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "targets": {
          "items": {
            "enum": [
              "aarch64-apple-darwin",
              "aarch64-unknown-linux-gnu",
              "x86_64-unknown-linux-gnu"
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "profile",
        "package",
        "targets",
        "feature_set"
      ],
      "type": "object"
    },
    "FeatureSet": {
      "additionalProperties": false,
      "properties": {
        "default_features": {
          "type": "boolean"
        },
        "features": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "default_features"
      ],
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "type": "object"
    },
    "Package": {
      "additionalProperties": false,
      "properties": {
        "features": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "links": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "rust_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/Target"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "features",
        "targets"
      ],
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "attestations": {
          "$ref": "#/$defs/Attestations"
        },
        "license_file": {
          "type": "string"
        }
      },
      "required": [
        "license_file",
        "attestations"
      ],
      "type": "object"
    },
    "Profile": {
      "enum": [
        "library",
        "cli",
        "service"
      ],
      "type": "string"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "required-features": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "type": "object"
    },
    "Workspace": {
      "additionalProperties": false,
      "properties": {
        "cargo_config_present": {
          "type": "boolean"
        },
        "cargo_lock_present": {
          "type": "boolean"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "packages": {
          "items": {
            "$ref": "#/$defs/Package"
          },
          "type": "array"
        }
      },
      "required": [
        "packages",
        "inputs",
        "cargo_config_present",
        "cargo_lock_present"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_state": {
      "type": "string"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/Change"
      },
      "type": "array"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "type": "array"
    },
    "input_preimages": {
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      },
      "type": "object"
    },
    "intent": {
      "$ref": "#/$defs/Config"
    },
    "lock_sha256": {
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "runtime_version": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "state": {
      "type": "string"
    },
    "state_sha256": {
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
      "type": [
        "string",
        "null"
      ]
    },
    "workspace": {
      "$ref": "#/$defs/Workspace"
    }
  },
  "required": [
    "runtime_version",
    "plan_sha256",
    "input_preimages",
    "schema_version",
    "mode",
    "repository",
    "intent",
    "state",
    "config_sha256",
    "capability_state",
    "workspace",
    "changes",
    "findings"
  ],
  "title": "Plan",
  "type": "object"
}
