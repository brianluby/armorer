{
  "$defs": {
    "Attestations": {
      "enum": [
        "required"
      ],
      "type": "string"
    },
    "Deliverable": {
      "additionalProperties": false,
      "properties": {
        "binary": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])",
          "type": [
            "string",
            "null"
          ]
        },
        "feature_set": {
          "pattern": "^(?!.*--)[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])",
          "type": "string"
        },
        "id": {
          "pattern": "^(?!.*--)[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])",
          "type": "string"
        },
        "package": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "targets": {
          "items": {
            "enum": [
              "aarch64-apple-darwin",
              "aarch64-unknown-linux-gnu",
              "x86_64-unknown-linux-gnu"
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "profile",
        "package",
        "targets",
        "feature_set"
      ],
      "type": "object"
    },
    "FeatureSet": {
      "additionalProperties": false,
      "properties": {
        "default_features": {
          "type": "boolean"
        },
        "features": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.-]{0,99}$(?![\\s\\S])",
            "type": "string"
          },
          "maxItems": 128,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "default_features"
      ],
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "attestations": {
          "$ref": "#/$defs/Attestations"
        },
        "license_file": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "license_file",
        "attestations"
      ],
      "type": "object"
    },
    "Profile": {
      "enum": [
        "library",
        "cli",
        "service"
      ],
      "type": "string"
    },
    "RepositoryFiles": {
      "additionalProperties": false,
      "description": "Opt-in switches for the optional managed repository files. Every switch is off\nby default; an absent table selects none of these files.",
      "properties": {
        "code_owners": {
          "description": "Manage `.github/CODEOWNERS` for these owners; an empty list leaves it unmanaged.",
          "items": {
            "pattern": "^@(?=[A-Za-z0-9-]{1,39}(?:/|$(?![\\s\\S])))[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*(?:/[A-Za-z0-9][A-Za-z0-9_.-]{0,99})?$(?![\\s\\S])",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array",
          "uniqueItems": true
        },
        "dependabot": {
          "default": false,
          "description": "Manage `.github/dependabot.yml` from the fixed catalog template.",
          "type": "boolean"
        },
        "security_policy": {
          "default": false,
          "description": "Manage `SECURITY.md` from the fixed catalog template.",
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deliverables": {
      "items": {
        "$ref": "#/$defs/Deliverable"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "feature_sets": {
      "additionalProperties": {
        "$ref": "#/$defs/FeatureSet"
      },
      "maxProperties": 128,
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?!.*--)[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])"
      },
      "type": "object"
    },
    "manifest": {
      "default": "Cargo.toml",
      "pattern": "^Cargo\\.toml$(?![\\s\\S])",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$(?![\\s\\S])",
      "type": "string"
    },
    "repository_files": {
      "$ref": "#/$defs/RepositoryFiles",
      "description": "Optional managed repository files. Omitted from every serialization while\nall switches are off, so existing configurations, plans and digests keep\ntheir exact bytes."
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "toolchain": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "toolchain",
    "deliverables",
    "feature_sets",
    "policy"
  ],
  "title": "Config",
  "type": "object"
}
