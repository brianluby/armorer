{
  "$defs": {
    "Attestations": {
      "enum": [
        "required"
      ],
      "type": "string"
    },
    "Deliverable": {
      "additionalProperties": false,
      "properties": {
        "binary": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])",
          "type": [
            "string",
            "null"
          ]
        },
        "feature_set": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])",
          "type": "string"
        },
        "package": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "targets": {
          "items": {
            "enum": [
              "aarch64-apple-darwin",
              "aarch64-unknown-linux-gnu",
              "x86_64-unknown-linux-gnu"
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "profile",
        "package",
        "targets",
        "feature_set"
      ],
      "type": "object"
    },
    "FeatureSet": {
      "additionalProperties": false,
      "properties": {
        "default_features": {
          "type": "boolean"
        },
        "features": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "default_features"
      ],
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "attestations": {
          "$ref": "#/$defs/Attestations"
        },
        "license_file": {
          "type": "string"
        }
      },
      "required": [
        "license_file",
        "attestations"
      ],
      "type": "object"
    },
    "Profile": {
      "enum": [
        "library",
        "cli",
        "service"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deliverables": {
      "items": {
        "$ref": "#/$defs/Deliverable"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "feature_sets": {
      "additionalProperties": {
        "$ref": "#/$defs/FeatureSet"
      },
      "maxProperties": 128,
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])"
      },
      "type": "object"
    },
    "manifest": {
      "default": "Cargo.toml",
      "pattern": "^Cargo\\.toml$(?![\\s\\S])",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$(?![\\s\\S])",
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "toolchain": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "toolchain",
    "deliverables",
    "feature_sets",
    "policy"
  ],
  "title": "Config",
  "type": "object"
}
