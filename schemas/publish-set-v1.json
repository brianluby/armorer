{
  "$defs": {
    "ByteIdentity": {
      "additionalProperties": false,
      "description": "An exact byte identity, independent of a filename or producer claim.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "maximum": 1073741824,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size"
      ],
      "type": "object"
    },
    "CrateIntent": {
      "additionalProperties": false,
      "properties": {
        "archive": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "dependencies": {
          "description": "Names within this approved set. External dependencies must be separately\nresolved/byte-verified before preparation by the future adapter.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "archive",
        "dependencies"
      ],
      "type": "object"
    },
    "InputIdentity": {
      "additionalProperties": false,
      "properties": {
        "cargo_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/RunIdentity"
        },
        "runtime": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "runtime_version": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "source",
        "config_sha256",
        "lock_sha256",
        "cargo_lock_sha256",
        "runtime",
        "runtime_version",
        "run"
      ],
      "type": "object"
    },
    "Registry": {
      "enum": [
        "crates-io"
      ],
      "type": "string"
    },
    "RunIdentity": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "workflow": {
          "$ref": "#/$defs/WorkflowIdentity"
        }
      },
      "required": [
        "id",
        "attempt",
        "workflow"
      ],
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "git_ref": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "git_ref"
      ],
      "type": "object"
    },
    "WorkflowIdentity": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "path",
        "commit"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "crates": {
      "items": {
        "$ref": "#/$defs/CrateIntent"
      },
      "type": "array"
    },
    "inputs": {
      "$ref": "#/$defs/InputIdentity"
    },
    "registry": {
      "$ref": "#/$defs/Registry"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "inputs",
    "registry",
    "crates"
  ],
  "title": "PublishSet",
  "type": "object"
}
