{
  "$defs": {
    "ByteIdentity": {
      "additionalProperties": false,
      "description": "An exact byte identity, independent of a filename or producer claim.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "maximum": 1073741824,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size"
      ],
      "type": "object"
    },
    "EvidenceScope": {
      "enum": [
        "final-artifact",
        "cargo-sbom-file",
        "sbom-predicate",
        "evidence-file",
        "inventory"
      ],
      "type": "string"
    },
    "HistoricalRelease": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "additionalProperties": {
            "$ref": "#/$defs/ByteIdentity"
          },
          "type": "object"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "source",
        "assets",
        "review",
        "limitations"
      ],
      "type": "object"
    },
    "Predicate": {
      "enum": [
        "https://slsa.dev/provenance/v1",
        "https://cyclonedx.org/bom"
      ],
      "type": "string"
    },
    "Review": {
      "additionalProperties": false,
      "description": "Review records bind a policy decision; their contents do not prove review occurred.",
      "properties": {
        "expires_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "owner": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "record": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "reviewed_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "owner",
        "rationale",
        "reviewed_at",
        "expires_at",
        "record"
      ],
      "type": "object"
    },
    "SignerRule": {
      "additionalProperties": false,
      "properties": {
        "predicate": {
          "$ref": "#/$defs/Predicate"
        },
        "scope": {
          "$ref": "#/$defs/EvidenceScope",
          "description": "Includes inventory authentication; never an arbitrary custom predicate."
        },
        "workflow": {
          "$ref": "#/$defs/WorkflowIdentity"
        }
      },
      "required": [
        "predicate",
        "workflow",
        "scope"
      ],
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "git_ref": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "git_ref"
      ],
      "type": "object"
    },
    "TrustBackend": {
      "enum": [
        "sigstore-public-good",
        "github-private"
      ],
      "type": "string"
    },
    "TrustRoots": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/TrustBackend"
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "trusted_root": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "verifier": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "verifier_version": {
          "type": "string"
        }
      },
      "required": [
        "backend",
        "trusted_root",
        "verifier",
        "verifier_version",
        "review"
      ],
      "type": "object"
    },
    "VerificationMode": {
      "enum": [
        "release",
        "rehearsal"
      ],
      "type": "string"
    },
    "WorkflowIdentity": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "path",
        "commit"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apple_team": {
      "type": [
        "string",
        "null"
      ]
    },
    "deny_self_hosted_runners": {
      "description": "v0.1 accepts hosted runners only.",
      "type": "boolean"
    },
    "historical": {
      "items": {
        "$ref": "#/$defs/HistoricalRelease"
      },
      "type": "array"
    },
    "mode": {
      "$ref": "#/$defs/VerificationMode"
    },
    "repository": {
      "type": "string"
    },
    "review": {
      "$ref": "#/$defs/Review"
    },
    "roots": {
      "$ref": "#/$defs/TrustRoots"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "signers": {
      "items": {
        "$ref": "#/$defs/SignerRule"
      },
      "type": "array"
    },
    "sources": {
      "description": "Exact reviewed release refs and commits; no regex or latest-tag policy.",
      "items": {
        "$ref": "#/$defs/Source"
      },
      "type": "array"
    },
    "supplemental_assets": {
      "additionalProperties": false,
      "description": "Supplemental roles, true = required, false = reporting when supplied.\nMissing diagnostics can never relax the fixed baseline asset set.",
      "properties": {
        "attestation-bundle": {
          "type": "boolean"
        },
        "build-evidence": {
          "type": "boolean"
        },
        "cargo-graph": {
          "type": "boolean"
        },
        "cargo-sbom": {
          "type": "boolean"
        },
        "diagnostic": {
          "type": "boolean"
        },
        "distributable": {
          "type": "boolean"
        },
        "embedded-metadata": {
          "type": "boolean"
        },
        "native-sbom": {
          "type": "boolean"
        },
        "package-evidence": {
          "type": "boolean"
        },
        "rebuild-evidence": {
          "type": "boolean"
        },
        "transformation-evidence": {
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "mode",
    "schema_version",
    "repository",
    "sources",
    "signers",
    "roots",
    "deny_self_hosted_runners",
    "supplemental_assets",
    "historical",
    "review"
  ],
  "title": "VerificationPolicy",
  "type": "object"
}
