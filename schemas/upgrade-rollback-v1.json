        "policy_schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "runtime_version": {
          "type": "string"
        },
        "tools_sha256": {
          "type": "string"
        },
        "workflow_commit": {
          "type": "string"
        },
        "workflow_repository": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "workflow_repository",
        "workflow_commit",
        "tools_sha256",
        "runtime_version",
        "config_schema_version",
        "policy_schema_version"
      ],
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "properties": {
        "after_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_content": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "before_content": {
          "type": [
            "string",
            "null"
          ]
        },
        "before_sha256": {
          "type": [
            "string",
            "null"
          ]
