          "minimum": 0,
          "type": "integer"
        },
        "recovery_required": {
          "type": "boolean"
        },
        "runtime_version": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
