        "state_preimages": {
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": "object"
        },
        "target_catalog": {
          "$ref": "#/$defs/Authority"
        },
        "workflow_after": {
          "$ref": "#/$defs/WorkflowPin"
        },
        "workflow_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowPin"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace": {
          "$ref": "#/$defs/Workspace"
        }
