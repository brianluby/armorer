{
  "$defs": {
    "ToolPin": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "WorkflowPin": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$(?![\\s\\S])",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
      "type": "string"
    },
    "runtime_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])",
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "tools": {
      "additionalProperties": {
        "$ref": "#/$defs/ToolPin"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$(?![\\s\\S])"
      },
      "type": "object"
    },
    "workflows": {
      "$ref": "#/$defs/WorkflowPin"
    }
  },
  "required": [
    "schema_version",
    "config_sha256",
    "runtime_version",
    "workflows",
    "tools"
  ],
  "title": "Lock",
  "type": "object"
}
