{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "type": "object"
    },
    "Package": {
      "additionalProperties": false,
      "properties": {
        "features": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "links": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "rust_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/Target"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "features",
        "targets"
      ],
      "type": "object"
    },
    "ProposedFile": {
      "additionalProperties": false,
      "description": "One exact file `init --write` would create.",
      "properties": {
        "content": {
          "type": "string"
        },
        "path": {
          "enum": [
            "armorer-policy.draft.toml",
            "armorer.toml"
          ],
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content",
        "sha256"
      ],
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "required-features": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "type": "object"
    },
    "Workspace": {
      "additionalProperties": false,
      "properties": {
        "cargo_config_present": {
          "type": "boolean"
        },
        "cargo_lock_present": {
          "type": "boolean"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "packages": {
          "items": {
            "$ref": "#/$defs/Package"
          },
          "type": "array"
        }
      },
      "required": [
        "packages",
        "inputs",
        "cargo_config_present",
        "cargo_lock_present"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Review document for `armorer init`; its digest authorizes `init --write`.",
  "properties": {
    "contract": {
      "const": "armorer-init-proposal",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ProposedFile"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "type": "array"
    },
    "proposal_sha256": {
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
      "type": "string"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$(?![\\s\\S])",
      "type": "string"
    },
    "runtime_version": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "toolchain": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])",
      "type": "string"
    },
    "workspace": {
      "$ref": "#/$defs/Workspace"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "runtime_version",
    "proposal_sha256",
    "repository",
    "toolchain",
    "workspace",
    "files",
    "findings"
  ],
  "title": "Proposal",
  "type": "object"
}
