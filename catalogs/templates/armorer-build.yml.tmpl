name: Armorer unsigned build

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: armorer-build-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.ref || github.sha }}
  cancel-in-progress: false

jobs:
  build:
    uses: %%WORKFLOW_REPOSITORY%%/.github/workflows/rust-build.yml@%%WORKFLOW_COMMIT%%
